# ===== Application =====
APP_NAME=localpaste
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== Database (PostgreSQL) =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=localpaste
POSTGRES_PASSWORD=localpaste_secret
POSTGRES_DB=localpaste

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== MinIO (S3-compatible) =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=pastes
MINIO_SECURE=false
MINIO_REGION=us-east-1

# ===== Auth / JWT (no expiry, signed tokens) =====
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret-string-localpaste
JWT_ALGORITHM=HS256
# 0 = no expiry (per project requirement)
JWT_EXPIRE_MINUTES=0

# ===== Encryption (AES-GCM optional payload protection) =====
AES_MASTER_KEY=0123456789abcdef0123456789abcdef

# ===== KGS (Key Generation Service) =====
KGS_KEY_LENGTH=6
KGS_POOL_TARGET=5000
KGS_REFILL_THRESHOLD=1000
KGS_REFILL_INTERVAL_SECONDS=15

# ===== Rate Limiting =====
RATE_LIMIT_ANON_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=120

# ===== CORS =====
CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://127.0.0.1:4200
